# Pick ONE LLM provider — fill in your key
OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...          # Free tier — recommended for student budget

# Model names
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector store
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_CORPUS=student_corpus
CHROMA_COLLECTION_MEMORY=student_memory

# RAG hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVE_K=10
RERANK_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# Memory
MEMORY_BUFFER_SIZE=10
MEMORY_SUMMARY_THRESHOLD=15

# Guards
INJECTION_CLASSIFIER=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_THRESHOLD=0.7

# Logging
TRACE_LOG_DIR=./logs
LOG_LEVEL=INFO
